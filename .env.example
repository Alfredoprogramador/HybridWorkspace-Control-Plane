# Environment variable template for local development
# Copy to .env and fill in the values

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-32-chars-min
JWT_SECRET=change-me-in-production-jwt-secret

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=hwcp_dev_password
DATABASE_URL=postgresql+asyncpg://hwcp:hwcp_dev_password@localhost:5432/hwcp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=hwcp_redis_dev
REDIS_URL=redis://:hwcp_redis_dev@localhost:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-nextauth-secret
BACKEND_URL=http://localhost:8000

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── SSO (optional) ───────────────────────────────────────────────────────────
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Headscale (Tailscale self-hosted) ────────────────────────────────────────
# HEADSCALE_API_KEY=
